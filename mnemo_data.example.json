    "title": "Git: Revert Last Commit Keeping Changes",
    "description": "Undoes the last commit while keeping modified files staged in your working directory.",
    "tags": [
      "git",
      "vcs",
      "workflow"
    ],
    "content": "git reset --soft HEAD~1",
